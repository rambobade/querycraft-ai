# QueryCraft AI - Environment Configuration Template

# Application
APP_ENV=development
PORT=8000
DATABASE_URL=sqlite:///./querycraft.db

# Path to the pre-seeded sample database
SAMPLE_DB_PATH=./database/sample_ecommerce.db

# Authentication (Generate a strong 32+ character random secret)
JWT_SECRET=super-secret-querycraft-ai-jwt-key-change-in-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Credentials Encryption (Fernet 32-byte base64 encoded key)
ENCRYPTION_KEY=cXVlcnljcmFmdC1haS1zZWN1cmUtZW5jcnlwdGlvbiE=

# AI & LLM Provider Configuration
# Supported providers: auto, openai, groq, ollama, gemini, heuristic
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1
LLM_TEMPERATURE=0.0

# Execution Safety & Rate Limits
READ_ONLY_MODE=true
QUERY_TIMEOUT_SECONDS=15
MAX_ROWS_RETURNED=1000
DEFAULT_LIMIT=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
